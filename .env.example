# JEDI DevProject runtime configuration template.
# Copy to .env and fill in values. Never commit .env.
# Full reference: docs/configuration-reference.md

# --- ServiceNow (split instances) ---
# PM/source instance: story retrieval and story writeback.
# HTTPS URL only; no credentials, fragments, or whitespace.
SERVICENOW_PM_INSTANCE_URL=
SERVICENOW_PM_CLIENT_ID=
# Secret. OAuth client secret for the PM instance.
SERVICENOW_PM_CLIENT_SECRET=
# DEV/target instance: development context discovery and reviewed Update Set import.
SERVICENOW_DEV_INSTANCE_URL=
SERVICENOW_DEV_CLIENT_ID=
# Secret. OAuth client secret for the DEV instance.
SERVICENOW_DEV_CLIENT_SECRET=
# Legacy single-instance fallback. Used only when the PM/DEV split values above are absent.
# A split value that is present but empty is a startup error; remove it to use the fallback.
SERVICENOW_INSTANCE_URL=https://<instance>.service-now.com
SERVICENOW_CLIENT_ID=
# Secret.
SERVICENOW_CLIENT_SECRET=

# --- Database and audit storage ---
# Secret. postgresql:// URL with a hostname; no fragments or whitespace. Used by API and worker.
DATABASE_URL=
# Required for docker compose local PostgreSQL. Secret. Not read by the Python runtime.
JEDI_POSTGRES_PASSWORD=
# Absolute path without whitespace; worker audit artifacts land here.
# Relative paths are rejected at startup. Containers use /app/artifacts/audit.
JEDI_AUDIT_ROOT=/absolute/path/to/artifacts/audit

# --- Runtime roles and API hardening ---
# development | production. production enables full hardening validation.
JEDI_ENVIRONMENT=development
# combined | api | worker. Prefer split api/worker services in production.
JEDI_RUNTIME_ROLE=combined
# Unique per worker replica; used for job claim ownership and audit actor id.
JEDI_WORKER_ID=jedi-devproject-worker
# Production combined role is an explicit exception. Prefer split api/worker services.
JEDI_ALLOW_COMBINED_PRODUCTION=false
# Required for production API or combined roles. Comma-separated Host header allowlist.
# Public hostnames or *.wildcard subdomains only; no "*" or local hosts.
JEDI_TRUSTED_HOSTS=

# --- Worker fulfillment gates (dry-run by default; worker-only) ---
# true lets the worker move eligible stories between the states below on claim.
JEDI_BUILD_CLAIM_APPLY=false
JEDI_BUILD_CLAIM_FROM_STATE=Ready
JEDI_BUILD_CLAIM_STATE=Work in Progress
# true enables retrieved Update Set import; requires JEDI_UPDATE_SET_USER_NAME.
JEDI_UPDATE_SET_APPLY=false
# ServiceNow user recorded for the Update Set import.
JEDI_UPDATE_SET_USER_NAME=
# false bypasses capability gating; development-only, rejected in production.
JEDI_CLASSIFIER_GATE=true

# --- Model providers (worker-only) ---
# Required in production for worker/combined roles. Only "openai" is supported.
JEDI_MODEL_PROVIDER=
# Secret. Required when JEDI_MODEL_PROVIDER=openai.
OPENAI_API_KEY=
# Required when JEDI_MODEL_PROVIDER=openai.
OPENAI_MODEL=

# --- Admin auth (API) ---
# Secret. Bearer token for JSON admin/artifact endpoints.
# Production: required when auth mode is disabled; ASCII, 32-8192 bytes.
JEDI_ADMIN_API_TOKEN=
# disabled | dev_basic | oidc | servicenow_oauth. dev_basic is development-only;
# oidc and servicenow_oauth are reserved and fail closed. See docs/admin-auth-config.md.
JEDI_ADMIN_AUTH_MODE=disabled
# Development-only Basic auth credentials for the browser admin console. Secret password.
JEDI_ADMIN_CONSOLE_USERNAME=
JEDI_ADMIN_CONSOLE_PASSWORD=
# Admin request body cap in bytes. Production maximum 65536.
JEDI_ADMIN_MAX_BODY_BYTES=8192
# Admin rate limit: requests per window per bucket, plus a cap on in-memory buckets.
JEDI_ADMIN_RATE_LIMIT_MAX_REQUESTS=120
JEDI_ADMIN_RATE_LIMIT_WINDOW_SECONDS=60
JEDI_ADMIN_RATE_LIMIT_MAX_BUCKETS=1024

# --- Lifecycle webhook (API; inbound POST /lifecycle/events) ---
# disabled | shared_secret | hmac_sha256 | servicenow_oauth. Production requires hmac_sha256.
JEDI_LIFECYCLE_WEBHOOK_AUTH_MODE=disabled
# Secret. Production: at least 32 characters, at most 8192 bytes, no whitespace.
JEDI_LIFECYCLE_WEBHOOK_SECRET=
# Secret. Outgoing secret accepted during rotation; must differ from the primary secret.
JEDI_LIFECYCLE_WEBHOOK_PREVIOUS_SECRET=
# Timestamp replay window. Production maximum 900.
JEDI_LIFECYCLE_WEBHOOK_MAX_SKEW_SECONDS=300
# Webhook request body cap in bytes. Production maximum 1048576.
JEDI_LIFECYCLE_WEBHOOK_MAX_BODY_BYTES=65536
# Lifecycle rate limit: requests per window per bucket, plus a cap on in-memory buckets.
JEDI_LIFECYCLE_RATE_LIMIT_MAX_REQUESTS=60
JEDI_LIFECYCLE_RATE_LIMIT_WINDOW_SECONDS=60
JEDI_LIFECYCLE_RATE_LIMIT_MAX_BUCKETS=1024

# --- API transport and job staleness ---
# Public production API roles must set this to true after HTTPS is final.
JEDI_STRICT_TRANSPORT_SECURITY_ENABLED=false
# HSTS max-age. Production minimum 31536000.
JEDI_STRICT_TRANSPORT_SECURITY_MAX_AGE_SECONDS=31536000
# Running jobs older than this are reported stale in admin views. Production maximum 86400.
JEDI_RUNNING_JOB_STALE_AFTER_SECONDS=3600

# --- Alerts (API; optional outbound HTTPS sink) ---
JEDI_ALERT_WEBHOOK_ENABLED=false
# Required when enabled. HTTPS only; no credentials, sensitive query params, or local targets.
JEDI_ALERT_WEBHOOK_URL=
# Production maximum 30.0.
JEDI_ALERT_WEBHOOK_TIMEOUT_SECONDS=3.0
# Production maximum 65536.
JEDI_ALERT_WEBHOOK_MAX_BODY_BYTES=16384

# --- Public web retrieval (worker-only; disabled by default) ---
# disabled | worker. "worker" requires the allowlist and doc URLs below.
JEDI_PUBLIC_WEB_ACCESS=disabled
# CSV of non-local public hostnames approved for retrieval.
JEDI_PUBLIC_WEB_ALLOWED_DOMAINS=
# CSV of HTTPS URLs whose hosts match JEDI_PUBLIC_WEB_ALLOWED_DOMAINS.
JEDI_PUBLIC_WEB_DOC_URLS=
# Production maximum 30.0.
JEDI_PUBLIC_WEB_TIMEOUT_SECONDS=3.0
# Production maximum 1048576.
JEDI_PUBLIC_WEB_MAX_RESPONSE_BYTES=131072
# Production maximum 16000.
JEDI_PUBLIC_WEB_MAX_EXCERPT_CHARS=4000
# Production maximum 10.
JEDI_PUBLIC_WEB_MAX_RESULTS=3
