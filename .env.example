SERVICENOW_PM_INSTANCE_URL=
SERVICENOW_PM_CLIENT_ID=
SERVICENOW_PM_CLIENT_SECRET=
SERVICENOW_DEV_INSTANCE_URL=
SERVICENOW_DEV_CLIENT_ID=
SERVICENOW_DEV_CLIENT_SECRET=
# Legacy single-instance fallback. Used only when the PM/DEV split values above are absent.
SERVICENOW_INSTANCE_URL=https://<instance>.service-now.com
SERVICENOW_CLIENT_ID=
SERVICENOW_CLIENT_SECRET=
DATABASE_URL=
# Required for docker compose local PostgreSQL.
JEDI_POSTGRES_PASSWORD=
JEDI_AUDIT_ROOT=artifacts/audit

JEDI_ENVIRONMENT=development
JEDI_RUNTIME_ROLE=combined
JEDI_WORKER_ID=jedi-devproject-worker
# Production combined role is an explicit exception. Prefer split api/worker services.
JEDI_ALLOW_COMBINED_PRODUCTION=false
# Required for production API or combined roles. Comma-separated Host header allowlist.
JEDI_TRUSTED_HOSTS=

JEDI_BUILD_CLAIM_APPLY=false
JEDI_BUILD_CLAIM_FROM_STATE=Ready
JEDI_BUILD_CLAIM_STATE=Work in Progress
JEDI_UPDATE_SET_APPLY=false
JEDI_UPDATE_SET_USER_NAME=
JEDI_CLASSIFIER_GATE=true

JEDI_MODEL_PROVIDER=
OPENAI_API_KEY=
OPENAI_MODEL=

JEDI_ADMIN_API_TOKEN=
JEDI_ADMIN_AUTH_MODE=disabled
JEDI_ADMIN_CONSOLE_USERNAME=
JEDI_ADMIN_CONSOLE_PASSWORD=
JEDI_ADMIN_MAX_BODY_BYTES=8192
JEDI_ADMIN_RATE_LIMIT_MAX_REQUESTS=120
JEDI_ADMIN_RATE_LIMIT_WINDOW_SECONDS=60
JEDI_ADMIN_RATE_LIMIT_MAX_BUCKETS=1024

JEDI_LIFECYCLE_WEBHOOK_AUTH_MODE=disabled
JEDI_LIFECYCLE_WEBHOOK_SECRET=
JEDI_LIFECYCLE_WEBHOOK_PREVIOUS_SECRET=
JEDI_LIFECYCLE_WEBHOOK_MAX_SKEW_SECONDS=300
JEDI_LIFECYCLE_WEBHOOK_MAX_BODY_BYTES=65536
JEDI_LIFECYCLE_RATE_LIMIT_MAX_REQUESTS=60
JEDI_LIFECYCLE_RATE_LIMIT_WINDOW_SECONDS=60
JEDI_LIFECYCLE_RATE_LIMIT_MAX_BUCKETS=1024

# Public production API roles must set this to true after HTTPS is final.
JEDI_STRICT_TRANSPORT_SECURITY_ENABLED=false
JEDI_STRICT_TRANSPORT_SECURITY_MAX_AGE_SECONDS=31536000
JEDI_RUNNING_JOB_STALE_AFTER_SECONDS=3600

JEDI_ALERT_WEBHOOK_ENABLED=false
JEDI_ALERT_WEBHOOK_URL=
JEDI_ALERT_WEBHOOK_TIMEOUT_SECONDS=3.0
JEDI_ALERT_WEBHOOK_MAX_BODY_BYTES=16384

JEDI_PUBLIC_WEB_ACCESS=disabled
JEDI_PUBLIC_WEB_ALLOWED_DOMAINS=
JEDI_PUBLIC_WEB_DOC_URLS=
JEDI_PUBLIC_WEB_TIMEOUT_SECONDS=3.0
JEDI_PUBLIC_WEB_MAX_RESPONSE_BYTES=131072
JEDI_PUBLIC_WEB_MAX_EXCERPT_CHARS=4000
JEDI_PUBLIC_WEB_MAX_RESULTS=3
